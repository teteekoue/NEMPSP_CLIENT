{
  "problemMatcher": [
    {
      "owner": "kotlin-compiler-error",
      "severity": "error",
      "pattern": [
        {
          "regexp": "^.*?e: (?:file://)?([^:]*\\.kt):(\\d+):(\\d+):?\\s*(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        }
      ]
    },
    {
      "owner": "kotlin-diagnostic-line",
      "severity": "error",
      "pattern": [
        {
          "regexp": "^(e: .*)$",
          "message": 1
        }
      ]
    },
    {
      "owner": "kotlin-source-line",
      "severity": "error",
      "pattern": [
        {
          "regexp": "^(.*[^A-Za-z][A-Za-z0-9_]+\\.kt.*)$",
          "message": 1
        }
      ]
    },
    {
      "owner": "java-error-line",
      "severity": "error",
      "pattern": [
        {
          "regexp": "^(.*\\berror: .*)$",
          "message": 1
        }
      ]
    },
    {
      "owner": "gradle-what-went-wrong",
      "severity": "error",
      "pattern": [
        {
          "regexp": "^\\* What went wrong:$"
        },
        {
          "regexp": "^(.+)$",
          "message": 1,
          "loop": true
        }
      ]
    },
    {
      "owner": "gradle-task-failed",
      "severity": "error",
      "pattern": [
        {
          "regexp": "^> Task (:\\S+) FAILED$",
          "message": 1
        }
      ]
    }
  ]
}
